{
  "compilerOptions": {
    "target": "es2017",
    "module": "commonjs",
    "lib": ["esnext", "dom"],
    "sourceMap": true,
    "removeComments": true,
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "jsx": "react",
    "declaration": true,
    "declarationDir": "build",
    "strictNullChecks": true,
    "skipLibCheck": true
  },
  "exclude": [
    "./node_modules/**/*",
    "tests"
  ]
}